# 服务
PORT=4173
HOST=0.0.0.0
# 每日更新时间（北京时间）
UPDATE_HOUR=18
UPDATE_MINUTE=30
TZ_NAME=Asia/Shanghai

# 抓取
FETCH_TIMEOUT_MS=12000
FETCH_CONCURRENCY=10
WINDOW_HOURS=36
MAX_STORIES=32
MIN_SOURCES=4

# 代理：留空时自动读取 Windows 系统代理；也可显式填写
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# 翻译（Google 翻译公开端点，批量请求并缓存；设为 0 可完全关闭）
TRANSLATE=1
TRANSLATION_CONCURRENCY=3
TRANSLATION_LIMIT=90

# AI 摘要 API：openai 兼容 / ollama / auto / none
# 例：DeepSeek  https://api.deepseek.com/v1  model=deepseek-chat
# 例：OpenAI    https://api.openai.com/v1   model=gpt-4o-mini
# 例：LM Studio http://127.0.0.1:1234/v1    model=本机已加载模型名
# 例：Ollama    http://127.0.0.1:11434      model=qwen2.5:7b
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_STORIES=24
LLM_BATCH_SIZE=5
LLM_TIMEOUT_MS=180000
LLM_TEMPERATURE=0.2

# 文章原图：优先 RSS media，缺失时读取原文页的 og:image；没有就保持空白
IMAGE_LOOKUP=1
IMAGE_LOOKUP_MAX=24
IMAGE_LOOKUP_CONCURRENCY=3
IMAGE_LOOKUP_TIMEOUT_MS=12000

# 本地生图：auto 先尝试 ComfyUI，失败则使用内置 SVG 封面
IMAGE_PROVIDER=auto
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=RealVisXL_V5.0_fp16.safetensors
COMFYUI_STEPS=26
COMFYUI_TIMEOUT_MS=240000

# 手动刷新保护（局域网访问时可选）
# ADMIN_TOKEN=change-me
